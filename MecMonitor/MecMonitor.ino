    font: 600 18px/1.1 var(--fonte); color: var(--fundo); background: var(--texto); border: 0; border-radius: 12px; cursor: pointer; }
  .btn:hover { background: #ffffff; }
  .btn:focus-visible { outline: 3px solid var(--foco); outline-offset: 3px; }
  .btn:disabled { opacity: 0.55; cursor: progress; }
  .btn svg { width: 26px; height: 26px; flex: none; }
  .dica { margin: 0; padding: 10px 12px; border-radius: 10px; font-size: 12.5px; line-height: 1.45; color: var(--suave); pointer-events: auto; }
  .dica code { font-family: ui-monospace, Consolas, monospace; font-size: 12px; color: var(--texto); overflow-wrap: anywhere; }

  .carregando { position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 360px; max-width: calc(100% - 32px); padding: 16px 18px; border-radius: 12px; font-size: 14px; color: var(--suave); }
  .carregando strong { display: block; margin-bottom: 10px; color: var(--texto); font-size: 15px; font-weight: 600; }
  .barra { height: 6px; border-radius: 3px; background: var(--linha); overflow: hidden; }
  .barra span { display: block; height: 100%; width: 0; background: var(--texto); transition: width 0.2s; }
  .carregando p { margin: 10px 0 0; line-height: 1.45; }

  .btn.sair { position: fixed; top: max(16px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); min-height: 44px; padding: 10px 16px; font-size: 15px;
    color: var(--texto); background: var(--vidro); border: 1px solid var(--linha); }
  .btn.sair:hover { background: rgba(30, 38, 46, 0.92); }
  .aviso-imersivo { position: fixed; left: 50%; bottom: max(24px, env(safe-area-inset-bottom)); transform: translateX(-50%); max-width: calc(100% - 32px);
    padding: 10px 16px; border-radius: 10px; font-size: 14px; color: var(--suave); text-align: center; transition: opacity 0.6s; }
  body.imersivo .hud { display: none; }

  @media (max-width: 900px) {
    .base { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .acao { grid-column: 1 / -1; max-width: none; flex-direction: row; align-items: center; }
    .dica { flex: 1; }
  }
  @media (max-width: 600px) {
    .hud { gap: 10px; }
    .marca p { display: none; }
    .status { font-size: 12.5px; padding: 6px 10px; }
    .cartao { padding: 10px; gap: 4px; }
    .cartao-topo { flex-direction: column; align-items: flex-start; gap: 4px; }
    .spark, .rodape { display: none; }
    .rotulo { font-size: 10.5px; letter-spacing: 0.05em; }
    .rotulo .local { display: none; }
    .chip { font-size: 10.5px; padding: 2px 7px; }
    .num { font-size: 28px; }
    .unid { font-size: 14px; }
    .acao { flex-direction: column; align-items: stretch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .status .led { animation: none !important; }
    .barra span, .aviso-imersivo { transition: none; }
  }
</style>
</head>
<body>
<canvas class="cena" id="cena" tabindex="-1" aria-label="Cena 3D da bancada da bomba centrífuga"></canvas>

<div class="hud" id="hud" data-sinal="aguardando">
  <header class="topo">
    <div class="marca vidro">
      <span class="tag" id="tag">P-101</span>
      <div>
        <h1>Bomba centrífuga</h1>
        <p>Bancada didática · MecMonitor</p>
      </div>
    </div>
    <div class="status vidro" id="status" data-estado="aguardando"><span class="led"></span><span id="status-texto">Conectando ao ESP32…</span></div>
  </header>

  <section class="base" id="base" aria-label="Leituras da bomba">
    <div class="acao" id="acao">
      <p class="dica vidro" id="dica" hidden></p>
      <button class="btn" id="btn-imersao" type="button" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h13A2.5 2.5 0 0 1 21 8.5v6a2.5 2.5 0 0 1-2.5 2.5h-3.2a1.5 1.5 0 0 1-1.3-.8l-1-1.8a1.2 1.2 0 0 0-2 0l-1 1.8a1.5 1.5 0 0 1-1.3.8H5.5A2.5 2.5 0 0 1 3 14.5z"/><circle cx="8" cy="11.5" r="1.6"/><circle cx="16" cy="11.5" r="1.6"/></svg>
        <span id="btn-texto">Carregando a cena 3D…</span>
      </button>
    </div>
  </section>
</div>

<div class="carregando vidro" id="carregando" role="status">
  <strong id="carregando-titulo">Carregando a cena 3D…</strong>
  <div class="barra"><span id="carregando-barra"></span></div>
  <p id="carregando-texto">Baixando o Babylon.js.</p>
</div>

<button class="btn sair" id="btn-sair" type="button" hidden>Sair do modo imersivo</button>
<div class="aviso-imersivo vidro" id="aviso-imersivo" hidden>Setas ou W A S D para andar · arraste para olhar · Esc ou Voltar para sair</div>

<script>
(function () {
  'use strict';

  // ================================ Configuração ================================
  const INTERVALO_MS = 200;            // 5 leituras por segundo
  const TIMEOUT_MS = 1500;
  const SINAL_PERDIDO_MS = 2500;
  const HISTORICO = 300;               // 300 leituras × 200 ms = último minuto
  const CORRENTE_NOMINAL = 3.0;        // A, da placa do motor (ajuste para o seu)
  const FATOR_SERVICO = 1.15;

  // Posições na cena, em metros, medidas por ferramentas/preparar-modelo.mjs.
  // A frente da bancada fica virada para -Z; o eixo da bomba é paralelo a X.
  const EIXO = { y: 0.8683, z: 0.043 };
  const MANCAL_MEIA_ALTURA = 0.0925;
  const PAINEL_ELETRICO = { x: 0.579, topo: 1.204, z: -0.257 };   // caixa CEMAR
  const PLACA_FRENTE_Z = 0.401;                                  // face da placa SENAI
  const INICIO = { x: -0.3, z: -2.1 };                           // onde o usuário começa no VR

  const METRICAS = {
    temp: { nome: 'Temperatura', local: 'mancal LA', unidade: '°C', casas: 1, min: 20, max: 100, alerta: 70, critico: 85,
      sensor: 'MAX6675 · termopar K', limites: 'alerta 70 · crítico 85' },
    vib: { nome: 'Vibração', local: 'mancal LA', unidade: 'mm/s', casas: 2, min: 0, max: 8, alerta: 2.8, critico: 4.5,
      sensor: 'MPU6050 · RMS', limites: 'alerta 2,8 · crítico 4,5' },
    corrente: { nome: 'Corrente', local: 'motor', unidade: 'A', casas: 2, min: 0, max: 5,
      alerta: CORRENTE_NOMINAL * 1.05, critico: CORRENTE_NOMINAL * FATOR_SERVICO,
      sensor: 'SCT013', limites: 'In 3,0 A · FS 1,15' }
  };
  const CHAVES = ['temp', 'vib', 'corrente'];
  const NOME_NIVEL = { normal: 'Normal', alerta: 'Alerta', critico: 'Crítico', parado: 'Parado', falha: 'Sem leitura', aguardando: '—' };
  const COR = { fundo: '#0d1115', texto: '#e9eef2', suave: '#9ba9b5', fraco: '#65727e', linha: '#2b353f',
    ok: '#3ecf8e', alerta: '#f0b429', critico: '#ff5d52', demo: '#7cc4ff' };
  const FONTE = '"Barlow", system-ui, sans-serif';
  const FONTE_NUM = '"Barlow Condensed", "Arial Narrow", sans-serif';

  // O Babylon.js vem de CDN: o aparelho que abre a página precisa de internet.
  const SCRIPTS_BABYLON = [
    ['https://cdn.jsdelivr.net/npm/babylonjs@9.27.1/babylon.js', 'https://unpkg.com/babylonjs@9.27.1/babylon.js'],
    ['https://cdn.jsdelivr.net/npm/babylonjs-loaders@9.27.1/babylonjs.loaders.min.js', 'https://unpkg.com/babylonjs-loaders@9.27.1/babylonjs.loaders.min.js']
  ];

  const reduzMovimento = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  const $ = (id) => document.getElementById(id);

  // ============================== Origem dos dados ==============================
  // Servida pelo ESP32 (http): lê /dados do próprio ESP32.
  // Aberta de outro lugar: use ?esp=192.168.0.50, ou ?demo para simular aqui mesmo.
  const params = new URLSearchParams(location.search);
  const espParam = params.get('esp');
  let base = null;
  if (espParam) base = 'http://' + espParam.replace(/^https?:\/\//, '').replace(/\/+$/, '') + '/';
  else if (location.protocol === 'http:' && !params.has('demo')) base = '';
  const modoDemo = base === null;
  const URL_DADOS = modoDemo ? null : base + 'dados';
  const URL_MODELO = (base || '') + 'bomba.glb';

  const estado = {
    valores: { temp: null, vib: null, corrente: null },
    historico: { temp: [], vib: [], corrente: [] },
    simulado: false,
    ultimoOk: 0,
    chegadas: [],
    sinal: 'aguardando',
    textoStatus: ''
  };
  const aoReceber = [];
  const aoMudarStatus = [];

  function nivel(chave) {
    if (estado.sinal === 'aguardando') return 'aguardando';
    const v = estado.valores[chave];
    if (v === null || !isFinite(v)) return 'falha';
    const m = METRICAS[chave];
    if (chave === 'corrente' && v < 0.3) return 'parado';
    if (v >= m.critico) return 'critico';
    if (v >= m.alerta) return 'alerta';
    return 'normal';
  }
  const destaque = (n) => n === 'alerta' || n === 'critico';
  const corNivel = (n) => n === 'critico' ? COR.critico : n === 'alerta' ? COR.alerta : COR.texto;

  function fmt(v, casas) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    return v.toLocaleString('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas });
  }

  function receber(d) {
    const agora = performance.now();
    estado.simulado = d.sim === true;
    CHAVES.forEach((k) => {
      const v = typeof d[k] === 'number' && isFinite(d[k]) ? d[k] : null;
      estado.valores[k] = v;
      const h = estado.historico[k];
      h.push(v);
      if (h.length > HISTORICO) h.shift();
    });
    estado.ultimoOk = agora;
    estado.chegadas.push(agora);
    while (estado.chegadas.length && agora - estado.chegadas[0] > 3000) estado.chegadas.shift();
    atualizarStatus();
    atualizarCartoes();
    aoReceber.forEach((f) => f());
  }

  function atualizarStatus() {
    const agora = performance.now();
    let sinal, texto;
    if (modoDemo) {
      sinal = 'demo';
      texto = 'Simulação local · sem ESP32';
    } else if (!estado.ultimoOk) {
      sinal = 'aguardando';
      texto = 'Conectando ao ESP32…';
    } else if (agora - estado.ultimoOk > SINAL_PERDIDO_MS) {
      sinal = 'perdido';
      texto = 'Sem sinal do ESP32 há ' + Math.round((agora - estado.ultimoOk) / 1000) + ' s';
    } else {
      sinal = 'vivo';
      const c = estado.chegadas;
      const hz = c.length > 1 ? (c.length - 1) / ((c[c.length - 1] - c[0]) / 1000) : 0;
      texto = (estado.simulado ? 'ESP32 · valores fictícios' : 'ESP32 ao vivo') + ' · ' + fmt(hz, 1) + ' Hz';
    }
    if (sinal === estado.sinal && texto === estado.textoStatus) return;
    const mudouSinal = sinal !== estado.sinal;
    estado.sinal = sinal;
    estado.textoStatus = texto;
    $('status').dataset.estado = sinal;
    $('status-texto').textContent = texto;
    $('hud').dataset.sinal = sinal;
    if (mudouSinal) atualizarCartoes();
    aoMudarStatus.forEach((f) => f());
  }

  async function buscar() {
    const inicio = performance.now();
    const controle = new AbortController();
    const limite = setTimeout(() => controle.abort(), TIMEOUT_MS);
    try {
      const r = await fetch(URL_DADOS, { cache: 'no-store', signal: controle.signal });
      if (!r.ok) throw new Error('HTTP ' + r.status);
      receber(await r.json());
    } catch (e) {
      // Sem resposta: o indicador de status mostra há quanto tempo.
    } finally {
      clearTimeout(limite);
      setTimeout(buscar, Math.max(0, INTERVALO_MS - (performance.now() - inicio)));
    }
  }

  // Mesma simulação do ESP32, para abrir a página sem a placa (?demo).
  function intensidadeEvento(t) {
    const fase = t % 120;
    if (fase < 70) return 0;
    if (fase < 80) return (fase - 70) / 10;
    if (fase < 95) return 1;
    if (fase < 110) return 1 - (fase - 95) / 15;
    return 0;
  }
  function iniciarDemo() {
    let temperatura = 46;
    const inicio = performance.now();
    const ruido = (a) => (Math.random() * 2 - 1) * a;
    const passo = () => {
      const t = (performance.now() - inicio) / 1000 + 50;   // o primeiro desbalanceamento começa ~20 s depois de abrir
      const ev = intensidadeEvento(t);
      const alvo = 48 + 2 * Math.sin(2 * Math.PI * t / 180) + 27 * ev;
      temperatura += (alvo - temperatura) * 0.03;
      receber({
        temp: Math.round((temperatura + ruido(0.2)) * 4) / 4,
        vib: 1.8 + 0.25 * Math.sin(2 * Math.PI * t / 13) + 3.4 * ev + ruido(0.12),
        corrente: 2.75 + 0.08 * Math.sin(2 * Math.PI * t / 7) + 0.5 * ev + ruido(0.03),
        sim: true
      });
    };
    passo();
    setInterval(passo, INTERVALO_MS);
  }

  // ============================== Desenho em canvas ==============================
  function retArred(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  // Ajusta o tamanho da fonte até o texto caber em larguraMax.
  function ajustarFonte(ctx, texto, peso, tamanho, familia, larguraMax) {
    let t = tamanho;
    ctx.font = peso + ' ' + t + 'px ' + familia;
    while (ctx.measureText(texto).width > larguraMax && t > 20) {
      t -= 4;
      ctx.font = peso + ' ' + t + 'px ' + familia;
    }
    return t;
  }

  // Tendência do último minuto: limites tracejados, área suave e ponto atual.
  function desenharSerie(ctx, x, y, w, h, serie, m, esc, corPonto) {
    const py = (v) => y + h - (Math.min(Math.max(v, m.min), m.max) - m.min) / (m.max - m.min) * h;
    const passo = w / (HISTORICO - 1);
    const x0 = x + w - (serie.length - 1) * passo;
    ctx.save();
    ctx.lineWidth = esc;
    ctx.setLineDash([3 * esc, 4 * esc]);
    [[m.alerta, COR.alerta], [m.critico, COR.critico]].forEach((lim) => {
      if (lim[0] > m.max) return;
      ctx.strokeStyle = lim[1];
      ctx.globalAlpha = 0.6;
      ctx.beginPath();
      ctx.moveTo(x, py(lim[0]));
      ctx.lineTo(x + w, py(lim[0]));
      ctx.stroke();
    });
    ctx.setLineDash([]);

    const trechos = [];
    let atual = null;
    serie.forEach((v, i) => {
      if (v === null) { atual = null; return; }
      if (!atual) { atual = []; trechos.push(atual); }
      atual.push([x0 + i * passo, py(v)]);
    });
    ctx.lineJoin = 'round';
    trechos.forEach((t) => {
      ctx.beginPath();
      t.forEach((p, j) => (j ? ctx.lineTo(p[0], p[1]) : ctx.moveTo(p[0], p[1])));
      ctx.globalAlpha = 0.9;
      ctx.strokeStyle = COR.texto;
      ctx.lineWidth = 1.6 * esc;
      ctx.stroke();
      ctx.lineTo(t[t.length - 1][0], y + h);
      ctx.lineTo(t[0][0], y + h);
      ctx.closePath();
      ctx.globalAlpha = 0.08;
      ctx.fillStyle = COR.texto;
      ctx.fill();
    });
    const ultimo = serie[serie.length - 1];
    if (ultimo !== null && ultimo !== undefined) {
      ctx.globalAlpha = 1;
      ctx.fillStyle = corPonto;
      ctx.beginPath();
      ctx.arc(x + w - 3 * esc, py(ultimo), 3.2 * esc, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }

  function larguraChip(ctx, n, esc) {
    ctx.font = '600 ' + 20 * esc + 'px ' + FONTE;
    return ctx.measureText(NOME_NIVEL[n]).width + 28 * esc;
  }
  function desenharChip(ctx, x, y, n, esc) {
    const w = larguraChip(ctx, n, esc);
    const h = 34 * esc;
    retArred(ctx, x, y, w, h, h / 2);
    if (destaque(n)) {
      ctx.fillStyle = corNivel(n);
      ctx.fill();
      ctx.fillStyle = COR.fundo;
    } else {
      ctx.lineWidth = 2;
      ctx.strokeStyle = COR.fraco;
      ctx.stroke();
      ctx.fillStyle = COR.texto;
    }
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.fillText(NOME_NIVEL[n], x + 14 * esc, y + h / 2 + esc);
    ctx.textBaseline = 'alphabetic';
  }

  // ================================= Painel 2D ==================================
  const cartoes = {};
  CHAVES.forEach((k) => {
    const m = METRICAS[k];
    const el = document.createElement('article');
    el.className = 'cartao vidro';
    el.dataset.nivel = 'aguardando';
    el.innerHTML = '<div class="cartao-topo"><span class="rotulo"></span><span class="chip">—</span></div>' +
      '<div class="leitura"><span class="num">—</span><span class="unid"></span></div>' +
      '<canvas class="spark" aria-hidden="true"></canvas>' +
      '<div class="rodape"><span></span><span></span></div>';
    el.querySelector('.rotulo').textContent = m.nome;
    const local = document.createElement('span');
    local.className = 'local';
    local.textContent = ' · ' + m.local;
    el.querySelector('.rotulo').appendChild(local);
    el.querySelector('.unid').textContent = m.unidade;
    el.querySelector('.rodape span').textContent = m.sensor;
    el.querySelector('.rodape span:last-child').textContent = m.limites;
    $('base').insertBefore(el, $('acao'));
    cartoes[k] = { el: el, num: el.querySelector('.num'), chip: el.querySelector('.chip'), spark: el.querySelector('.spark') };
  });

  function atualizarCartoes() {
    CHAVES.forEach((k) => {
      const c = cartoes[k];
      const n = nivel(k);
      c.el.dataset.nivel = n;
      c.num.textContent = fmt(estado.valores[k], METRICAS[k].casas);
      c.chip.textContent = NOME_NIVEL[n];
      const cv = c.spark;
      const w = cv.clientWidth, h = cv.clientHeight;
      if (!w || !h) return;                   // escondido em telas estreitas
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      if (cv.width !== Math.round(w * dpr) || cv.height !== Math.round(h * dpr)) {
        cv.width = Math.round(w * dpr);
        cv.height = Math.round(h * dpr);
      }
      const ctx = cv.getContext('2d');
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      desenharSerie(ctx, 0, 3, w, h - 6, estado.historico[k], METRICAS[k], 1, corNivel(n));
    });
  }
  window.addEventListener('resize', atualizarCartoes);

  function mostrarCarregamento(titulo, texto, fracao) {
    $('carregando').hidden = false;
    $('carregando-titulo').textContent = titulo;
    $('carregando-texto').textContent = texto;
    $('carregando-barra').style.width = Math.round(Math.max(0, Math.min(1, fracao)) * 100) + '%';
  }

  // ================================== Cena 3D ===================================
  let engine = null, scene = null, camOrbita = null, camPasseio = null, xr = null;
  let suportaXR = false, imersivo = false;

  function carregarScript(urls) {
    return new Promise((resolve, reject) => {
      const tentar = (i) => {
        if (i >= urls.length) return reject(new Error('não foi possível baixar ' + urls[0]));
        const s = document.createElement('script');
        s.src = urls[i];
        s.onload = resolve;
        s.onerror = () => { s.remove(); tentar(i + 1); };
        document.head.appendChild(s);
      };
      tentar(0);
    });
  }

  function iniciar3D() {
    const B = BABYLON;
    const V3 = (x, y, z) => new B.Vector3(x, y, z);
    const canvas = $('cena');

    engine = new B.Engine(canvas, true, { stencil: true, preserveDrawingBuffer: false });
    engine.setHardwareScalingLevel(1 / Math.min(window.devicePixelRatio || 1, 2));
    scene = new B.Scene(engine);
    const corFundo = B.Color3.FromHexString(COR.fundo);
    scene.clearColor = B.Color4.FromColor3(corFundo, 1);
    scene.fogMode = B.Scene.FOGMODE_EXP2;
    scene.fogDensity = 0.07;
    scene.fogColor = corFundo;
    scene.skipPointerMovePicking = true;

    // Câmera de órbita: arrastar gira, roda/pinça aproxima. Fica sempre na frente da bancada.
    camOrbita = new B.ArcRotateCamera('orbita', -Math.PI / 2 + 0.05, 1.22, 4.3, V3(-0.45, 0.72, -0.1), scene);
    camOrbita.lowerAlphaLimit = -Math.PI + 0.25;
    camOrbita.upperAlphaLimit = -0.25;
    camOrbita.lowerBetaLimit = 0.35;
    camOrbita.upperBetaLimit = 1.5;
    camOrbita.lowerRadiusLimit = 1.0;
    camOrbita.upperRadiusLimit = 8;
    camOrbita.wheelDeltaPercentage = 0.02;
    camOrbita.pinchDeltaPercentage = 0.01;
    camOrbita.panningSensibility = 0;
    camOrbita.minZ = 0.03;
    camOrbita.maxZ = 100;
    camOrbita.attachControl(canvas, true);

    const ceu = new B.HemisphericLight('ceu', V3(0.25, 1, -0.4), scene);
    ceu.intensity = 0.85;
    ceu.groundColor = new B.Color3(0.17, 0.18, 0.2);
    ceu.specular = new B.Color3(0.15, 0.15, 0.15);
    const sol = new B.DirectionalLight('sol', V3(0.35, -1, 0.6), scene);
    sol.intensity = 0.7;

    function mat(nome, hex, brilho, alpha) {
      const m = new B.StandardMaterial(nome, scene);
      m.diffuseColor = B.Color3.FromHexString(hex);
      const s = brilho === undefined ? 0.2 : brilho;
      m.specularColor = new B.Color3(s, s, s);
      m.specularPower = 48;
      if (alpha !== undefined) m.alpha = alpha;
      return m;
    }
    const M = {
      estrutura: mat('estrutura', '#2e343b', 0.25),
      faixa: mat('faixa-piso', '#e0b21e', 0.05),
      aco: mat('aco', '#aab2ba', 0.7),
      cabo: mat('cabo', '#1d2024', 0.3),
      preto: mat('preto', '#15171a', 0.4),
      placaAzul: mat('placa-mpu6050', '#2446b8', 0.4),
      caixa: mat('caixa-esp32', '#d4d8dc', 0.2),
      led: mat('led', '#0b1a33', 0.6)
    };

    // Piso de epóxi com juntas a cada 1 m, faixa amarela de segurança em volta da bancada.
    const chao = B.MeshBuilder.CreateGround('chao', { width: 60, height: 60 }, scene);
    const texPiso = new B.DynamicTexture('piso', { width: 256, height: 256 }, scene, true);
    const cp = texPiso.getContext();
    cp.fillStyle = '#39423f';
    cp.fillRect(0, 0, 256, 256);
    for (let i = 0; i < 900; i++) {
      cp.fillStyle = 'rgba(255,255,255,' + (Math.random() * 0.025).toFixed(3) + ')';
      cp.fillRect(Math.random() * 256, Math.random() * 256, 2, 2);
    }
    cp.strokeStyle = 'rgba(0,0,0,0.35)';
    cp.lineWidth = 3;
    cp.strokeRect(0, 0, 256, 256);
    texPiso.update();
    texPiso.wrapU = texPiso.wrapV = B.Texture.WRAP_ADDRESSMODE;
    texPiso.uScale = texPiso.vScale = 60;
    texPiso.anisotropicFilteringLevel = 8;
    const matPiso = new B.StandardMaterial('piso', scene);
    matPiso.diffuseTexture = texPiso;
    matPiso.specularColor = new B.Color3(0.06, 0.06, 0.06);
    chao.material = matPiso;

    function caixa(nome, w, h, d, x, y, z, material, pai) {
      const b = B.MeshBuilder.CreateBox(nome, { width: w, height: h, depth: d }, scene);
      b.position.set(x, y, z);
      b.material = material;
      if (pai) b.parent = pai;
      return b;
    }
    function cilindroY(nome, diametro, altura, x, y, z, material, pai) {
      const c = B.MeshBuilder.CreateCylinder(nome, { diameter: diametro, height: altura, tessellation: 24 }, scene);
      c.position.set(x, y, z);
      c.material = material;
      if (pai) c.parent = pai;
      return c;
    }

    const faixa = (w, d, x, z) => caixa('faixa', w, 0.006, d, x, 0.003, z, M.faixa);
    faixa(2.5, 0.08, 0, -1.0);
    faixa(2.5, 0.08, 0, 0.75);
    faixa(0.08, 1.75, -1.25, -0.125);
    faixa(0.08, 1.75, 1.25, -0.125);

    // Sombra de contato sob a bancada (mais leve que sombras em tempo real no óculos).
    const sombra = B.MeshBuilder.CreateGround('sombra', { width: 2.4, height: 1.5 }, scene);
    sombra.position.set(0, 0.008, 0);
    const texSombra = new B.DynamicTexture('sombra', { width: 256, height: 256 }, scene, false);
    const cs = texSombra.getContext();
    cs.setTransform(1, 0, 0, 0.6, 0, 51);
    const grad = cs.createRadialGradient(128, 128, 8, 128, 128, 128);
    grad.addColorStop(0, 'rgba(0,0,0,0.6)');
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    cs.fillStyle = grad;
    cs.fillRect(0, 0, 256, 256);
    texSombra.update();
    texSombra.hasAlpha = true;
    const matSombra = new B.StandardMaterial('sombra', scene);
    matSombra.diffuseTexture = texSombra;
    matSombra.useAlphaFromDiffuseTexture = true;
    matSombra.disableLighting = true;
    sombra.material = matSombra;

    // Estrutura de metalon (ilustrativa: o modelo do SolidWorks não inclui a mesa).
    const p = 0.04;
    [[-0.86, -0.48], [0.86, -0.48], [-0.86, 0.38], [0.86, 0.38]].forEach((c) => caixa('perna', p, 0.638, p, c[0], 0.319, c[1], M.estrutura));
    [0.618, 0.30].forEach((y) => {
      caixa('travessa', 1.76, p, p, 0, y, -0.48, M.estrutura);
      caixa('travessa', 1.76, p, p, 0, y, 0.38, M.estrutura);
      caixa('travessa', p, p, 0.9, -0.86, y, -0.05, M.estrutura);
      caixa('travessa', p, p, 0.9, 0.86, y, -0.05, M.estrutura);
    });
    [-0.40, 0.45].forEach((x) => caixa('apoio-bomba', p, p, 0.9, x, 0.618, -0.05, M.estrutura));
    [0.10, 0.70].forEach((x) => caixa('apoio-reservatorio', p, p, 0.9, x, 0.30, -0.05, M.estrutura));

    // ---------------------------- Sensores físicos ----------------------------
    // Os sensores do mancal vibram junto com ele.
    const noSensoresMancal = new B.TransformNode('sensores-mancal', scene);
    const topoMancal = EIXO.y + MANCAL_MEIA_ALTURA;
    const frenteMancal = EIXO.z - MANCAL_MEIA_ALTURA;
    // MAX6675: termopar tipo K rosqueado no topo do mancal
    cilindroY('termopar-conexao', 0.02, 0.016, -0.09, topoMancal + 0.008, EIXO.z, M.aco, noSensoresMancal);
    cilindroY('termopar-haste', 0.007, 0.07, -0.09, topoMancal + 0.05, EIXO.z, M.aco, noSensoresMancal);
    // MPU6050 (módulo GY-521) colado na face frontal do mancal
    caixa('mpu6050', 0.042, 0.032, 0.005, -0.05, EIXO.y, frenteMancal - 0.0027, M.placaAzul, noSensoresMancal);
    caixa('mpu6050-chip', 0.009, 0.009, 0.002, -0.05, EIXO.y, frenteMancal - 0.0062, M.preto, noSensoresMancal);

    // Cabo do motor até o painel elétrico, com o SCT013 abraçando o cabo.
    const PE = PAINEL_ELETRICO;
    const pontosCabo = B.Curve3.CreateCatmullRomSpline([
      V3(0.30, 0.95, 0.17), V3(0.31, 1.05, 0.13), V3(0.38, 1.12, 0.0), V3(0.49, 1.22, -0.16),
      V3(PE.x - 0.02, 1.31, PE.z + 0.01), V3(PE.x, 1.26, PE.z), V3(PE.x, PE.topo - 0.01, PE.z)
    ], 12).getPoints();
    const cabo = B.MeshBuilder.CreateTube('cabo-motor', { path: pontosCabo, radius: 0.009, tessellation: 12, cap: B.Mesh.CAP_ALL }, scene);
    const matCabo = M.cabo;
    cabo.material = matCabo;
    let iSct = pontosCabo.length - 2;
    pontosCabo.forEach((pt, i) => { if (i > pontosCabo.length * 0.6 && Math.abs(pt.y - 1.255) < Math.abs(pontosCabo[iSct].y - 1.255)) iSct = i; });
    const posSct = pontosCabo[iSct];
    const tangente = pontosCabo[Math.min(iSct + 1, pontosCabo.length - 1)].subtract(pontosCabo[Math.max(iSct - 1, 0)]).normalize();
    const noSct = new B.TransformNode('sct013', scene);
    noSct.position.copyFrom(posSct);
    noSct.rotationQuaternion = new B.Quaternion();
    B.Quaternion.FromUnitVectorsToRef(B.Vector3.Up(), tangente, noSct.rotationQuaternion);
    const anelSct = B.MeshBuilder.CreateTorus('sct013-anel', { diameter: 0.042, thickness: 0.016, tessellation: 28 }, scene);
    anelSct.material = M.preto;
    anelSct.parent = noSct;
    caixa('sct013-corpo', 0.036, 0.022, 0.024, -0.034, 0, 0, M.preto, noSct);
    cilindroY('prensa-cabo', 0.03, 0.02, PE.x, PE.topo + 0.01, PE.z, M.preto);

    // ESP32 numa caixa presa à placa da bancada; o LED pisca a cada leitura recebida.
    const zCaixa = PLACA_FRENTE_Z - 0.03;
    caixa('caixa-esp32', 0.16, 0.11, 0.06, -0.62, 1.45, zCaixa, M.caixa);
    const etiqueta = B.MeshBuilder.CreatePlane('etiqueta-esp32', { width: 0.12, height: 0.03 }, scene);
    etiqueta.position.set(-0.635, 1.43, zCaixa - 0.0305);
    const texEtiqueta = new B.DynamicTexture('etiqueta-esp32', { width: 256, height: 64 }, scene, true);
    const ce = texEtiqueta.getContext();
    ce.fillStyle = '#d4d8dc';
    ce.fillRect(0, 0, 256, 64);
    ce.fillStyle = '#1b2127';
    ce.font = '600 34px ' + FONTE;
    ce.textBaseline = 'middle';
    ce.fillText('ESP32', 16, 34);
    texEtiqueta.update();
    const matEtiqueta = new B.StandardMaterial('etiqueta-esp32', scene);
    matEtiqueta.diffuseTexture = texEtiqueta;
    matEtiqueta.specularColor = new B.Color3(0.1, 0.1, 0.1);
    etiqueta.material = matEtiqueta;
    const led = B.MeshBuilder.CreateSphere('led-esp32', { diameter: 0.012, segments: 8 }, scene);
    led.position.set(-0.57, 1.475, zCaixa - 0.031);
    led.material = M.led;
    cilindroY('antena-esp32', 0.007, 0.08, -0.565, 1.545, zCaixa, M.preto);
    let brilhoLed = 0;
    aoReceber.push(() => { brilhoLed = 1; });

    // --------------------------- Rótulos dos sensores ---------------------------
    function planoComTextura(nome, largura, altura, px, py) {
      const plano = B.MeshBuilder.CreatePlane(nome, { width: largura, height: altura }, scene);
      const tex = new B.DynamicTexture(nome, { width: px, height: py }, scene, true);
      tex.hasAlpha = true;
      tex.anisotropicFilteringLevel = 8;
      // A textura entra como luz própria: o texto fica com o brilho exato do canvas,
      // sem depender das luzes da cena (como textura difusa ele saía quase preto).
      const m = new B.StandardMaterial(nome, scene);
      m.diffuseColor = B.Color3.Black();
      m.specularColor = B.Color3.Black();
      m.emissiveTexture = tex;
      m.opacityTexture = tex;
      m.disableLighting = true;
      m.fogEnabled = false;
      plano.material = m;
      return { plano: plano, tex: tex };
    }

    const rotulos = [
      { chave: 'vib', titulo: 'VIBRAÇÃO · MPU6050', pos: V3(-0.72, 1.2, -0.5), alvo: V3(-0.05, EIXO.y, frenteMancal - 0.006) },
      { chave: 'temp', titulo: 'TEMPERATURA · MAX6675', pos: V3(-0.12, 1.36, -0.5), alvo: V3(-0.09, topoMancal + 0.085, EIXO.z) },
      { chave: 'corrente', titulo: 'CORRENTE · SCT013', pos: V3(0.62, 1.5, -0.5), alvo: posSct }
    ].map((r) => {
      const p2 = planoComTextura('rotulo-' + r.chave, 0.46, 0.158, 512, 176);
      p2.plano.position.copyFrom(r.pos);
      p2.plano.billboardMode = B.Mesh.BILLBOARDMODE_ALL;
      const linha = B.MeshBuilder.CreateLines('guia-' + r.chave, { points: [r.alvo, r.pos.add(V3(0, -0.079, 0))] }, scene);
      linha.color = B.Color3.FromHexString(COR.suave);
      linha.alpha = 0.75;
      r.tex = p2.tex;
      return r;
    });

    function desenharRotulo(r) {
      const ctx = r.tex.getContext();
      const W = 512, H = 176;
      const m = METRICAS[r.chave];
      const n = nivel(r.chave);
      ctx.clearRect(0, 0, W, H);
      retArred(ctx, 3, 3, W - 6, H - 6, 22);
      ctx.fillStyle = 'rgba(13,17,21,0.9)';
      ctx.fill();
      ctx.lineWidth = destaque(n) ? 6 : 2.5;
      ctx.strokeStyle = destaque(n) ? corNivel(n) : COR.linha;
      ctx.stroke();
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      ctx.fillStyle = COR.suave;
      ctx.font = '600 25px ' + FONTE;
      ctx.fillText(r.titulo, 28, 48);
      const txt = fmt(estado.valores[r.chave], m.casas);
      ctx.fillStyle = estado.sinal === 'perdido' ? COR.fraco : corNivel(n);
      ajustarFonte(ctx, txt, 600, 88, FONTE_NUM, 210);
      ctx.fillText(txt, 28, 142);
      const lw = ctx.measureText(txt).width;
      ctx.fillStyle = COR.suave;
      ctx.font = '500 32px ' + FONTE;
      ctx.fillText(m.unidade, 28 + lw + 10, 142);
      if (n !== 'normal') desenharChip(ctx, W - 28 - larguraChip(ctx, n, 1), 110, n, 1);
      r.tex.update();
    }

    // ------------------- Painel de leituras (legível no óculos) -------------------
    const painel = planoComTextura('painel', 1.6, 0.9375, 1024, 600);
    painel.plano.position.set(-1.65, 1.45, -0.25);
    painel.plano.rotation.y = -0.55;       // virado para quem está na frente da bancada
    const texPainel = painel.tex;

    function textoStatus3D() {
      return estado.textoStatus || 'Conectando ao ESP32…';
    }
    function corStatus() {
      return estado.sinal === 'vivo' ? COR.ok : estado.sinal === 'demo' ? COR.demo : estado.sinal === 'perdido' ? COR.critico : COR.suave;
    }

    function desenharPainel() {
      const ctx = texPainel.getContext();
      const W = 1024, H = 600;
      ctx.clearRect(0, 0, W, H);
      retArred(ctx, 4, 4, W - 8, H - 8, 30);
      ctx.fillStyle = 'rgba(13,17,21,0.92)';
      ctx.fill();
      ctx.lineWidth = 3;
      ctx.strokeStyle = COR.linha;
      ctx.stroke();

      ctx.textBaseline = 'alphabetic';
      ctx.textAlign = 'left';
      ctx.fillStyle = COR.texto;
      ctx.font = '600 46px ' + FONTE_NUM;
      ctx.fillText($('tag').textContent + '  Bomba centrífuga', 44, 78);
      ctx.textAlign = 'right';
      ctx.font = '500 26px ' + FONTE;
      ctx.fillStyle = corStatus();
      ctx.fillText(textoStatus3D(), W - 44, 76);

      const gap = 22, x0 = 44, y0 = 108;
      const cw = (W - 2 * x0 - 2 * gap) / 3, ch = H - y0 - 40;
      CHAVES.forEach((k, i) => {
        const m = METRICAS[k];
        const n = nivel(k);
        const x = x0 + i * (cw + gap);
        retArred(ctx, x, y0, cw, ch, 20);
        ctx.fillStyle = 'rgba(255,255,255,0.035)';
        ctx.fill();
        ctx.lineWidth = destaque(n) ? 5 : 2;
        ctx.strokeStyle = destaque(n) ? corNivel(n) : COR.linha;
        ctx.stroke();

        ctx.textAlign = 'left';
        ctx.fillStyle = COR.suave;
        ctx.font = '600 22px ' + FONTE;
        ctx.fillText(m.nome.toUpperCase(), x + 22, y0 + 44);
        ctx.textAlign = 'right';
        ctx.fillStyle = COR.fraco;
        ctx.font = '500 20px ' + FONTE;
        ctx.fillText(m.local, x + cw - 22, y0 + 44);

        ctx.textAlign = 'left';
        const txt = fmt(estado.valores[k], m.casas);
        ctx.fillStyle = estado.sinal === 'perdido' ? COR.fraco : corNivel(n);
        ajustarFonte(ctx, txt, 600, 104, FONTE_NUM, cw - 44 - 76);
        ctx.fillText(txt, x + 22, y0 + 150);
        const lw = ctx.measureText(txt).width;
        ctx.fillStyle = COR.suave;
        ctx.font = '500 30px ' + FONTE;
        ctx.fillText(m.unidade, x + 22 + lw + 8, y0 + 150);

        desenharChip(ctx, x + 22, y0 + 178, n, 1);
        desenharSerie(ctx, x + 22, y0 + 238, cw - 44, 150, estado.historico[k], m, 2, corNivel(n));

        ctx.textAlign = 'left';
        ctx.fillStyle = COR.fraco;
        ctx.font = '500 19px ' + FONTE;
        ctx.fillText(m.sensor, x + 22, y0 + ch - 22);
      });
      texPainel.update();
    }

    // Botão "Sair do VR", visível só dentro do óculos (aponte o controle e aperte o gatilho).
    const sair = planoComTextura('botao-sair-vr', 0.46, 0.12, 512, 134);
    sair.plano.position.set(-1.65, 0.86, -0.25);
    sair.plano.rotation.y = -0.55;
    sair.plano.setEnabled(false);
    (function () {
      const ctx = sair.tex.getContext();
      retArred(ctx, 4, 4, 504, 126, 63);
      ctx.fillStyle = COR.texto;
      ctx.fill();
      ctx.fillStyle = COR.fundo;
      ctx.font = '600 44px ' + FONTE;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('Sair do VR', 256, 70);
      sair.tex.update();
    })();

    let ultimoPainel = 0;
    function redesenhar(forcar) {
      rotulos.forEach(desenharRotulo);
      const agora = performance.now();
      if (forcar || agora - ultimoPainel > 400) {
        ultimoPainel = agora;
        desenharPainel();
      }
    }
    aoReceber.push(() => redesenhar(false));
    aoMudarStatus.push(() => redesenhar(false));
    redesenhar(true);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => redesenhar(true));

    // ------------------------------ Modelo da bancada ------------------------------
    const partes = { rotor: null, mancal: null, motor: null };
    const matsMancal = [], matsMotor = [];
    const posBase = new Map();

    async function carregarModelo() {
      mostrarCarregamento('Carregando a bancada 3D…', 'Recebendo o modelo do ESP32.', 0.05);
      const aoProgredir = (ev) => {
        if (ev.lengthComputable && ev.total) mostrarCarregamento('Carregando a bancada 3D…', 'Recebendo o modelo do ESP32.', ev.loaded / ev.total);
      };
      const container = B.LoadAssetContainerAsync
        ? await B.LoadAssetContainerAsync(URL_MODELO, scene, { pluginExtension: '.glb', onProgress: aoProgredir })
        : await B.SceneLoader.LoadAssetContainerAsync('', URL_MODELO, scene, aoProgredir, '.glb');
      container.addAllToScene();

      // O SolidWorks exporta PBR; aqui cada cor vira um material simples, mais leve no óculos.
      const convertidos = new Map();
      container.meshes.forEach((malha) => {
        const pbr = malha.material;
        if (!pbr) return;
        let std = convertidos.get(pbr);
        if (!std) {
          const cor = pbr.albedoColor || pbr.baseColor || pbr.diffuseColor || new B.Color3(0.6, 0.6, 0.6);
          std = new B.StandardMaterial(pbr.name + '-simples', scene);
          std.diffuseColor = cor.toGammaSpace();
          std.specularColor = new B.Color3(0.16, 0.16, 0.16);
          std.specularPower = 32;
          std.alpha = pbr.alpha;
          std.backFaceCulling = pbr.backFaceCulling;
          convertidos.set(pbr, std);
        }
        malha.material = std;
      });
      convertidos.forEach((_, pbr) => pbr.dispose());

      const nos = container.transformNodes.concat(container.meshes);
      Object.keys(partes).forEach((nome) => { partes[nome] = nos.find((n) => n.name === nome) || null; });
      container.meshes.forEach((malha) => {
        if (partes.mancal && malha.isDescendantOf(partes.mancal)) {
          malha.material = malha.material.clone(malha.material.name + '-mancal');
          matsMancal.push(malha.material);
        } else if (partes.motor && malha.isDescendantOf(partes.motor)) {
          malha.material = malha.material.clone(malha.material.name + '-motor');
          matsMotor.push(malha.material);
        }
        malha.isPickable = false;
      });
      if (partes.rotor) partes.rotor.rotationQuaternion = null;
      ['rotor', 'mancal', 'motor'].forEach((nome) => { if (partes[nome]) posBase.set(partes[nome], partes[nome].position.clone()); });
      $('carregando').hidden = true;
    }

    // ------------------------------ Animação ------------------------------
    let velRotor = 0, vibSuave = 0, calor = 0, t = 0;
    const corCalor = new B.Color3(1, 0.3, 0.06);
    const corSobrecarga = new B.Color3(1, 0.62, 0.1);
    let ultimaInteracao = performance.now(), baseOcioso = null, tOcioso = 0;
    ['pointerdown', 'wheel', 'keydown', 'touchstart'].forEach((ev) => window.addEventListener(ev, () => {
      ultimaInteracao = performance.now();
      baseOcioso = null;
    }, { passive: true }));

    scene.onBeforeRenderObservable.add(() => {
      const dt = Math.min(engine.getDeltaTime() / 1000, 0.1);
      t += dt;
      const v = estado.valores;
      const semDados = estado.sinal === 'perdido' || estado.sinal === 'aguardando';

      // O eixo gira enquanto houver corrente (velocidade ilustrativa: 3450 rpm real viraria um borrão).
      const alvoRot = !semDados && v.corrente !== null && v.corrente >= 0.3 ? 2 * Math.PI * 1.2 : 0;
      velRotor += (alvoRot - velRotor) * Math.min(1, dt * 1.5);
      if (partes.rotor) partes.rotor.rotation.x += velRotor * dt;

      // Tremor do conjunto proporcional à vibração, bem exagerado para ficar visível.
      vibSuave += ((semDados || v.vib === null ? 0 : v.vib) - vibSuave) * Math.min(1, dt * 4);
      const amp = Math.max(0, vibSuave - 1.0) * 0.0012 * (reduzMovimento ? 0.4 : 1);
      const dx = amp * (Math.sin(t * 61) * 0.6 + Math.sin(t * 97) * 0.4);
      const dy = amp * 0.5 * Math.sin(t * 73 + 1);
      const dz = amp * (Math.sin(t * 67 + 2) * 0.6 + Math.sin(t * 89) * 0.4);
      posBase.forEach((p0, no) => no.position.set(p0.x - dx, p0.y + dy, p0.z + dz));  // o nó raiz do glTF espelha X
      noSensoresMancal.position.set(dx, dy, dz);

      // Mancal ganha brilho avermelhado acima de 45 °C.
      const k = v.temp === null ? 0 : Math.min(Math.max((v.temp - 45) / 40, 0), 1);
      calor += (k - calor) * Math.min(1, dt * 2);
      const intensidade = Math.pow(calor, 1.4) * 0.9;
      matsMancal.forEach((m) => m.emissiveColor.copyFrom(corCalor).scaleInPlace(intensidade));

      // Corrente acima da nominal: motor e cabo acendem em âmbar, pulsando.
      const nc = semDados ? 'normal' : nivel('corrente');
      const pulso = reduzMovimento ? 1 : 0.7 + 0.3 * Math.sin(t * 6);
      const sobrecarga = (nc === 'critico' ? 0.55 : nc === 'alerta' ? 0.3 : 0) * pulso;
      matsMotor.forEach((m) => m.emissiveColor.copyFrom(corSobrecarga).scaleInPlace(sobrecarga));
      matCabo.emissiveColor.copyFrom(corSobrecarga).scaleInPlace(sobrecarga * 1.4);

      brilhoLed = Math.max(0, brilhoLed - dt * 8);
      M.led.emissiveColor.set(0.15 * brilhoLed, 0.45 * brilhoLed, brilhoLed);

      // Parado há 12 s (TV na parede): a câmera balança devagar para mostrar a bancada.
      if (!reduzMovimento && !imersivo && scene.activeCamera === camOrbita && performance.now() - ultimaInteracao > 12000) {
        if (baseOcioso === null) { baseOcioso = camOrbita.alpha; tOcioso = 0; }
        tOcioso += dt;
        camOrbita.alpha = baseOcioso + 0.3 * Math.sin(tOcioso * 0.15);
      }
      if (imersivo && camPasseio) camPasseio.position.y = 1.6;
    });

    engine.runRenderLoop(() => scene.render());
    window.addEventListener('resize', () => engine.resize());

    // Só o chão e o botão "Sair do VR" recebem o raio do controle.
    scene.meshes.forEach((m) => { m.isPickable = m === chao || m === sair.plano; });
    scene.onPointerObservable.add((info) => {
      if (info.type === B.PointerEventTypes.POINTERDOWN && info.pickInfo && info.pickInfo.pickedMesh === sair.plano && xr) {
        xr.baseExperience.exitXRAsync();
      }
    });

    carregarModelo().catch((erro) => {
      console.error(erro);
      mostrarCarregamento('O modelo 3D da bancada não carregou',
        'Recarregue a página. Se continuar, confira se o sketch foi gravado com o modelo embutido (' + (erro && erro.message ? erro.message : erro) + ').', 1);
    });

    return prepararXR(chao, sair.plano);
  }

  // ================================= WebXR ==================================
  async function prepararXR(chao, botaoSair) {
    try {
      if (!navigator.xr || !BABYLON.WebXRSessionManager) return;
      suportaXR = await BABYLON.WebXRSessionManager.IsSessionSupportedAsync('immersive-vr');
      if (!suportaXR) return;
      xr = await scene.createDefaultXRExperienceAsync({ floorMeshes: [chao], disableDefaultUI: true });
      const exp = xr.baseExperience;
      const posicionar = (cam) => { cam.position.x = INICIO.x; cam.position.z = INICIO.z; };
      if (exp.onInitialXRPoseSetObservable) exp.onInitialXRPoseSetObservable.add(posicionar);
      exp.onStateChangedObservable.add((s) => {
        botaoSair.setEnabled(s === BABYLON.WebXRState.IN_XR);
      });
    } catch (e) {
      console.warn('WebXR indisponível:', e);
      suportaXR = false;
      xr = null;
    }
  }

  function entrarXR() {
    // O VR começa de frente para a bancada, a ~2 m dela.
    camOrbita.alpha = -Math.PI / 2;
    camOrbita.beta = 1.4;
    xr.baseExperience.enterXRAsync('immersive-vr', 'local-floor', xr.renderTarget).catch((erro) => {
      console.warn(erro);
      mostrarDica('Não foi possível iniciar o VR (' + (erro && erro.message ? erro.message : erro) + '). Abrindo o modo imersivo em tela cheia.');
      entrarModoImersivo();
    });
  }

  // Sem óculos: tela cheia com câmera na altura dos olhos, andando pelas setas (controle da TV) ou W A S D.
  function entrarModoImersivo() {
    const B = BABYLON;
    const canvas = $('cena');
    if (!camPasseio) {
      camPasseio = new B.UniversalCamera('passeio', new B.Vector3(INICIO.x, 1.6, INICIO.z), scene);
      camPasseio.minZ = 0.03;
      camPasseio.maxZ = 100;
      camPasseio.speed = 0.05;
      camPasseio.inertia = 0.7;
      camPasseio.angularSensibility = 2500;
      camPasseio.keysUp = [38, 87];
      camPasseio.keysDown = [40, 83];
      if ('keysRotateLeft' in camPasseio) {
        camPasseio.keysRotateLeft = [37];
        camPasseio.keysRotateRight = [39];
        camPasseio.keysLeft = [65];
        camPasseio.keysRight = [68];
      } else {
        camPasseio.keysLeft = [37, 65];
        camPasseio.keysRight = [39, 68];
      }
    }
    camPasseio.position.set(INICIO.x, 1.6, INICIO.z);
    camPasseio.setTarget(new B.Vector3(-0.5, 1.1, 0));
    camOrbita.detachControl();
    scene.activeCamera = camPasseio;
    camPasseio.attachControl(canvas, true);
    imersivo = true;
    document.body.classList.add('imersivo');
    $('btn-sair').hidden = false;
    canvas.focus();
    const el = document.documentElement;
    if (el.requestFullscreen) el.requestFullscreen().catch(() => {});
    try { history.pushState({ imersivo: true }, ''); } catch (e) { /* navegador sem histórico */ }

    const aviso = $('aviso-imersivo');
    aviso.hidden = false;
    aviso.style.opacity = '1';
    setTimeout(() => { aviso.style.opacity = '0'; }, 4000);
    setTimeout(() => { aviso.hidden = true; }, 4700);
  }

  function sairModoImersivo() {
    if (!imersivo) return;
    imersivo = false;
    camPasseio.detachControl();
    scene.activeCamera = camOrbita;
    camOrbita.attachControl($('cena'), true);
    document.body.classList.remove('imersivo');
    $('btn-sair').hidden = true;
    $('aviso-imersivo').hidden = true;
    if (document.fullscreenElement && document.exitFullscreen) document.exitFullscreen().catch(() => {});
    try { if (history.state && history.state.imersivo) history.back(); } catch (e) { /* ignora */ }
    $('btn-imersao').focus();
  }
  document.addEventListener('fullscreenchange', () => { if (!document.fullscreenElement) sairModoImersivo(); });
  window.addEventListener('popstate', sairModoImersivo);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') sairModoImersivo(); });
  $('btn-sair').addEventListener('click', sairModoImersivo);

  function mostrarDica(texto, html) {
    const d = $('dica');
    if (html) d.innerHTML = html; else d.textContent = texto;
    d.hidden = false;
  }
  const escapar = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

  function configurarBotao() {
    const btn = $('btn-imersao');
    btn.disabled = false;
    if (suportaXR && xr) {
      $('btn-texto').textContent = 'Entrar em VR';
    } else {
      $('btn-texto').textContent = 'Modo imersivo';
      if (location.protocol === 'http:' && !window.isSecureContext) {
        mostrarDica('', 'Para VR no óculos, libere este endereço no navegador dele: <code>chrome://flags</code> → “Insecure origins treated as secure” → <code>' +
          escapar(location.origin) + '</code>.');
      } else {
        mostrarDica('Nenhum óculos VR encontrado. O modo imersivo abre a cena em tela cheia; ande com as setas ou W A S D.');
      }
    }
    btn.addEventListener('click', () => { if (suportaXR && xr) entrarXR(); else entrarModoImersivo(); });
    if (!(window.matchMedia && window.matchMedia('(pointer: fine)').matches)) btn.focus();
  }

  // =================================== Início ===================================
  setInterval(atualizarStatus, 500);
  if (modoDemo) iniciarDemo(); else buscar();

  mostrarCarregamento('Carregando a cena 3D…', 'Baixando o Babylon.js.', 0.02);
  carregarScript(SCRIPTS_BABYLON[0])
    .then(() => { mostrarCarregamento('Carregando a cena 3D…', 'Baixando o leitor de modelos.', 0.04); return carregarScript(SCRIPTS_BABYLON[1]); })
    .then(iniciar3D)
    .then(configurarBotao)
    .catch((erro) => {
      console.error(erro);
      mostrarCarregamento('A cena 3D não carregou',
        'Este aparelho precisa de internet para baixar o Babylon.js. As leituras continuam no painel abaixo. (' + (erro && erro.message ? erro.message : erro) + ')', 1);
      $('btn-texto').textContent = 'Cena 3D indisponível';
    });
})();
</script>
</body>
</html>
