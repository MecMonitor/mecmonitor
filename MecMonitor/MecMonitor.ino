/*
  =====================================================================================
   MecMonitor · bancada de bomba centrífuga em 3D (ESP32 + Babylon.js + WebXR)
  =====================================================================================
   Um único sketch: o ESP32 lê (ou simula) temperatura, vibração e corrente da bomba
   e serve pelo Wi-Fi a aplicação 3D completa — HTML, CSS, JavaScript e o modelo 3D
   da bancada (exportado do SolidWorks, reduzido e embutido no fim deste arquivo).

   COMO GRAVAR
     1. Arduino IDE > Gerenciador de Placas > "esp32" da Espressif (versão 3.x).
     2. Ferramentas > Placa > ESP32 Dev Module
     3. Ferramentas > Partition Scheme > "Huge APP (3MB No OTA/1MB SPIFFS)"
        O modelo 3D embutido não cabe na partição padrão de 1,2 MB.
     4. Preencha WIFI_SSID e WIFI_SENHA logo abaixo e carregue o sketch.
     5. Abra o Monitor Serial em 115200 baud: aparece o endereço da aplicação,
        por exemplo http://192.168.0.50 (ou http://mecmonitor.local).
   Nenhuma biblioteca extra: só WiFi, WebServer, ESPmDNS e Wire, que vêm com o pacote.

   ABRINDO A APLICAÇÃO
     No computador, na TV ou nos óculos VR, na mesma rede Wi-Fi, abra o endereço acima.
     O aparelho precisa de internet: o Babylon.js tem vários MB e vem de uma CDN,
     porque não cabe na flash junto com o modelo. Por isso o ESP32 entra na rede do
     roteador. Se não conseguir, ele cria a rede "MecMonitor" (senha mecmonitor123,
     endereço http://192.168.4.1). Nesse modo as leituras aparecem, mas a cena 3D só
     carrega se o aparelho tiver internet por outro caminho (dados móveis, por exemplo).

   VR NOS ÓCULOS (Meta Quest e similares)
     O WebXR só funciona em páginas seguras (HTTPS), e o ESP32 serve HTTP. Libere o
     endereço uma vez no navegador dos óculos:
        chrome://flags > "Insecure origins treated as secure"
        digite http://<IP-do-ESP32> > Enabled > Relaunch
     Depois disso aparece o botão "Entrar em VR". Na TV e no computador, o mesmo botão
     abre o modo imersivo em tela cheia (setas ou W A S D para andar).

   LIGAÇÕES (usadas quando MODO_SIMULADO = false)
     MAX6675 (termopar tipo K)  VCC 3V3 · GND · SCK GPIO18 · CS GPIO5 · SO GPIO19
     MPU6050 (acelerômetro)     VCC 3V3 · GND · SDA GPIO21 · SCL GPIO22
     SCT013 (saída em tensão)   um fio no GPIO34; o outro no ponto médio de um divisor
                                10 kΩ + 10 kΩ entre 3V3 e GND, com um capacitor de
                                10 µF desse ponto para o GND.
       - Use um pino do ADC1 (GPIO32 a 39): o ADC2 não funciona com o Wi-Fi ligado.
       - Passe só UM condutor (uma fase) por dentro do sensor.
       - Motor de poucos ampères? Prefira o SCT013-005 (5 A/1 V), ou dê 2 ou 3 voltas
         do fio no SCT013-030 e divida SCT_AMPERES_POR_VOLT pelo número de voltas.

   ENDEREÇOS
     /           aplicação 3D
     /dados      leituras em JSON: {"temp":48.25,"vib":1.93,"corrente":2.81,"sim":true,"uptime":42}
     /bomba.glb  modelo 3D da bancada (gzip)
*/

#include <WiFi.h>
#include <WebServer.h>
#include <ESPmDNS.h>
#include <Wire.h>
#include <math.h>
#include "mbedtls/base64.h"

// ================================= Configuração =================================
const char* WIFI_SSID  = "NOME_DA_SUA_REDE";   // rede de 2,4 GHz (o ESP32 não usa 5 GHz)
const char* WIFI_SENHA = "SENHA_DA_SUA_REDE";

const char* NOME_MDNS = "mecmonitor";          // http://mecmonitor.local
const char* AP_SSID   = "MecMonitor";          // rede própria, se o roteador não responder
const char* AP_SENHA  = "mecmonitor123";       // mínimo de 8 caracteres

// true  = envia valores fictícios (não precisa de sensores ligados)
// false = lê MAX6675, MPU6050 e SCT013
const bool MODO_SIMULADO = true;

// Dados da máquina, usados com os sensores reais. Ajuste para a placa do seu motor.
const float RPM_NOMINAL          = 3450.0f;    // motor de II polos em 60 Hz
const float SCT_AMPERES_POR_VOLT = 30.0f;      // SCT013-030: 30 A -> 1 V RMS
const float CORRENTE_MINIMA      = 0.15f;      // abaixo disso é ruído do ADC

// Pinos
const int PINO_MAX_SCK = 18;
const int PINO_MAX_CS  = 5;
const int PINO_MAX_SO  = 19;
const int PINO_SDA     = 21;
const int PINO_SCL     = 22;
const int PINO_SCT     = 34;
const int PINO_LED     = 2;                    // LED azul da placa: pisca a cada leitura enviada

const uint8_t MPU_ENDERECO = 0x68;

// Conteúdo servido, definido no fim deste arquivo
extern const char PAGINA[] PROGMEM;
extern const char MODELO_VERSAO[];
extern const char MODELO_GLB_GZ_B64[] PROGMEM;

WebServer servidor(80);

struct Leituras {
  float temp = NAN;        // °C
  float vib = NAN;         // mm/s RMS
  float corrente = NAN;    // A RMS
} leitura;

unsigned long ledApagarEm = 0;

// =============================== Valores fictícios ===============================
float ruido(float amplitude) {
  return amplitude * (random(-1000, 1001) / 1000.0f);
}

// A cada 2 minutos simula um desbalanceamento de cerca de 40 s: a vibração sobe até
// a faixa crítica, a corrente passa da nominal e o mancal esquenta.
float intensidadeEvento(float t) {
  float fase = fmodf(t, 120.0f);
  if (fase < 70.0f)  return 0.0f;
  if (fase < 80.0f)  return (fase - 70.0f) / 10.0f;
  if (fase < 95.0f)  return 1.0f;
  if (fase < 110.0f) return 1.0f - (fase - 95.0f) / 15.0f;
  return 0.0f;
}

// Chamada a cada 200 ms
void atualizarSimulado() {
  static float temperatura = 46.0f;    // o mancal esquenta e esfria devagar
  float t = millis() / 1000.0f;
  float ev = intensidadeEvento(t);

  float alvo = 48.0f + 2.0f * sinf(2 * PI * t / 180.0f) + 27.0f * ev;
  temperatura += (alvo - temperatura) * 0.03f;
  leitura.temp = roundf((temperatura + ruido(0.2f)) * 4.0f) / 4.0f;   // o MAX6675 mede em passos de 0,25 °C

  leitura.vib = 1.8f + 0.25f * sinf(2 * PI * t / 13.0f) + 3.4f * ev + ruido(0.12f);
  leitura.corrente = 2.75f + 0.08f * sinf(2 * PI * t / 7.0f) + 0.5f * ev + ruido(0.03f);
}

// ================================ Sensores reais =================================
// MAX6675: leitura por software (SPI só de recepção, 16 bits).
float lerMAX6675() {
  digitalWrite(PINO_MAX_CS, LOW);
  delayMicroseconds(10);
  uint16_t bruto = 0;
  for (int i = 15; i >= 0; i--) {
    digitalWrite(PINO_MAX_SCK, LOW);
    delayMicroseconds(10);
    if (digitalRead(PINO_MAX_SO)) bruto |= (1 << i);
    digitalWrite(PINO_MAX_SCK, HIGH);
    delayMicroseconds(10);
  }
  digitalWrite(PINO_MAX_CS, HIGH);
  if (bruto & 0x4) return NAN;           // bit D2 = termopar aberto (desconectado)
  return (bruto >> 3) * 0.25f;
}

bool escreverMPU(uint8_t registrador, uint8_t valor) {
  Wire.beginTransmission(MPU_ENDERECO);
  Wire.write(registrador);
  Wire.write(valor);
  return Wire.endTransmission() == 0;
}

bool iniciarMPU6050() {
  Wire.begin(PINO_SDA, PINO_SCL);
  Wire.setClock(400000);
  return escreverMPU(0x6B, 0x00)         // PWR_MGMT_1: acorda o sensor
      && escreverMPU(0x1A, 0x01)         // CONFIG: filtro passa-baixa de 184 Hz
      && escreverMPU(0x1C, 0x00);        // ACCEL_CONFIG: ±2 g (16384 LSB/g)
}

bool lerAceleracao(float a[3]) {
  Wire.beginTransmission(MPU_ENDERECO);
  Wire.write(0x3B);                      // ACCEL_XOUT_H
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((int)MPU_ENDERECO, 6) != 6) return false;
  uint8_t b[6];
  for (int i = 0; i < 6; i++) b[i] = Wire.read();
  for (int i = 0; i < 3; i++) a[i] = (int16_t)((b[2 * i] << 8) | b[2 * i + 1]) / 16384.0f;
  return true;
}

// Vibração: amostra o acelerômetro a ~1 kHz sem travar o servidor e, a cada 512
// amostras (~0,5 s), converte a aceleração RMS em velocidade RMS (mm/s).
// A conversão v = a / (2·π·f) vale para a componente na frequência de rotação (1× RPM),
// que domina em desbalanceamento e desalinhamento, os defeitos mais comuns.
struct AcumuladorVibracao {
  double soma[3] = {0, 0, 0};
  double somaQuadrados[3] = {0, 0, 0};
  uint16_t n = 0;
  unsigned long ultimaAmostraUs = 0;
} acumulador;

void amostrarVibracao() {
  unsigned long agora = micros();
  if (agora - acumulador.ultimaAmostraUs < 1000) return;
  acumulador.ultimaAmostraUs = agora;

  float a[3];
  if (!lerAceleracao(a)) {
    leitura.vib = NAN;
    return;
  }
  for (int i = 0; i < 3; i++) {
    acumulador.soma[i] += a[i];
    acumulador.somaQuadrados[i] += (double)a[i] * a[i];
  }
  if (++acumulador.n < 512) return;

  double variancia = 0;                  // a média de cada eixo (gravidade) sai aqui
  for (int i = 0; i < 3; i++) {
    double media = acumulador.soma[i] / acumulador.n;
    variancia += acumulador.somaQuadrados[i] / acumulador.n - media * media;
    acumulador.soma[i] = acumulador.somaQuadrados[i] = 0;
  }
  acumulador.n = 0;
  double aRms = (variancia > 0 ? sqrt(variancia) : 0) * 9.80665;    // m/s²
  double frequencia = RPM_NOMINAL / 60.0;                            // Hz
  leitura.vib = aRms / (2.0 * PI * frequencia) * 1000.0;             // mm/s
}

// Corrente: amostra o SCT013 por 100 ms (6 ciclos de 60 Hz) e calcula o valor RMS.
// A variância já descarta o 1,65 V do divisor de polarização.
float lerCorrenteRMS() {
  double soma = 0, somaQuadrados = 0;
  uint32_t n = 0;
  unsigned long inicio = millis();
  while (millis() - inicio < 100) {
    double mv = analogReadMilliVolts(PINO_SCT);
    soma += mv;
    somaQuadrados += mv * mv;
    n++;
  }
  double media = soma / n;
  double variancia = somaQuadrados / n - media * media;
  float vRms = variancia > 0 ? sqrt(variancia) / 1000.0 : 0;         // V
  float corrente = vRms * SCT_AMPERES_POR_VOLT;
  return corrente < CORRENTE_MINIMA ? 0.0f : corrente;
}

void atualizarSensores() {
  static unsigned long ultimaLeituraLenta = 0;
  amostrarVibracao();
  if (millis() - ultimaLeituraLenta < 500) return;   // o MAX6675 precisa de ~220 ms por conversão
  ultimaLeituraLenta = millis();
  leitura.temp = lerMAX6675();
  leitura.corrente = lerCorrenteRMS();
}

// ================================ Servidor web ===================================
void formatarValor(char* destino, size_t tamanho, float valor) {
  if (isnan(valor)) snprintf(destino, tamanho, "null");
  else snprintf(destino, tamanho, "%.2f", valor);
}

void enviarDados() {
  char temp[16], vib[16], corrente[16], json[200];
  formatarValor(temp, sizeof temp, leitura.temp);
  formatarValor(vib, sizeof vib, leitura.vib);
  formatarValor(corrente, sizeof corrente, leitura.corrente);
  snprintf(json, sizeof json, "{\"temp\":%s,\"vib\":%s,\"corrente\":%s,\"sim\":%s,\"uptime\":%lu}",
           temp, vib, corrente, MODO_SIMULADO ? "true" : "false", millis() / 1000);
  servidor.sendHeader("Access-Control-Allow-Origin", "*");
  servidor.sendHeader("Cache-Control", "no-store");
  servidor.send(200, "application/json", json);

  digitalWrite(PINO_LED, HIGH);
  ledApagarEm = millis() + 30;
}

void enviarPagina() {
  servidor.sendHeader("Cache-Control", "no-cache");
  servidor.send_P(200, "text/html; charset=utf-8", PAGINA);
}

// O modelo fica gravado em Base64. Aqui ele é decodificado em blocos e enviado como
// binário gzip; o navegador descompacta sozinho (Content-Encoding: gzip). O ETag deixa
// o navegador reaproveitar a cópia que já tem quando o modelo não mudou.
void enviarModelo() {
  String etag = String("\"") + MODELO_VERSAO + "\"";
  servidor.sendHeader("ETag", etag);
  servidor.sendHeader("Cache-Control", "no-cache");
  servidor.sendHeader("Access-Control-Allow-Origin", "*");
  if (servidor.header("If-None-Match") == etag) {
    servidor.send(304);
    return;
  }

  static size_t tamanhoB64 = strlen(MODELO_GLB_GZ_B64);
  if (tamanhoB64 < 4) {
    servidor.send(404, "text/plain; charset=utf-8", "Modelo 3D não embutido: rode ferramentas/preparar-modelo.mjs");
    return;
  }
  size_t preenchimento = (MODELO_GLB_GZ_B64[tamanhoB64 - 1] == '=') + (MODELO_GLB_GZ_B64[tamanhoB64 - 2] == '=');
  servidor.sendHeader("Content-Encoding", "gzip");
  servidor.setContentLength(tamanhoB64 / 4 * 3 - preenchimento);
  servidor.send(200, "model/gltf-binary", "");

  static uint8_t bloco[3072];            // 4096 caracteres Base64 -> 3072 bytes
  for (size_t i = 0; i < tamanhoB64; i += 4096) {
    size_t n = tamanhoB64 - i < 4096 ? tamanhoB64 - i : 4096;
    size_t decodificados = 0;
    if (mbedtls_base64_decode(bloco, sizeof bloco, &decodificados,
                              (const unsigned char*)MODELO_GLB_GZ_B64 + i, n) != 0) break;
    servidor.sendContent((const char*)bloco, decodificados);
    if (!servidor.client().connected()) break;
  }
}

void conectarWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);                  // respostas mais rápidas
  WiFi.begin(WIFI_SSID, WIFI_SENHA);
  Serial.printf("Conectando a \"%s\"", WIFI_SSID);
  unsigned long inicio = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - inicio < 20000) {
    delay(500);
    Serial.print('.');
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    WiFi.setAutoReconnect(true);
    Serial.print("Conectado. Abra http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("Não conectou ao roteador. Criando a rede própria \"MecMonitor\"...");
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID, AP_SENHA);
    Serial.printf("Conecte-se à rede \"%s\" (senha %s) e abra http://", AP_SSID, AP_SENHA);
    Serial.println(WiFi.softAPIP());
  }
  if (MDNS.begin(NOME_MDNS)) {
    MDNS.addService("http", "tcp", 80);
    Serial.printf("Ou abra http://%s.local\n", NOME_MDNS);
  }
}

void setup() {
  Serial.begin(115200);
  delay(200);
  pinMode(PINO_LED, OUTPUT);

  if (MODO_SIMULADO) {
    Serial.println("\nMecMonitor · modo simulado: enviando valores fictícios.");
    atualizarSimulado();
  } else {
    Serial.println("\nMecMonitor · lendo MAX6675, MPU6050 e SCT013.");
    pinMode(PINO_MAX_CS, OUTPUT);
    digitalWrite(PINO_MAX_CS, HIGH);
    pinMode(PINO_MAX_SCK, OUTPUT);
    digitalWrite(PINO_MAX_SCK, LOW);
    pinMode(PINO_MAX_SO, INPUT);
    if (!iniciarMPU6050()) Serial.println("O MPU6050 não respondeu: confira SDA, SCL e o endereço 0x68.");
    analogReadResolution(12);
  }

  conectarWiFi();

  const char* cabecalhos[] = {"If-None-Match"};
  servidor.collectHeaders(cabecalhos, 1);
  servidor.on("/", HTTP_GET, enviarPagina);
  servidor.on("/index.html", HTTP_GET, enviarPagina);
  servidor.on("/dados", HTTP_GET, enviarDados);
  servidor.on("/bomba.glb", HTTP_GET, enviarModelo);
  servidor.onNotFound([]() {
    servidor.send(404, "text/plain; charset=utf-8", "Não encontrado");
  });
  servidor.begin();
}

void loop() {
  servidor.handleClient();

  if (MODO_SIMULADO) {
    static unsigned long ultima = 0;
    if (millis() - ultima >= 200) {
      ultima = millis();
      atualizarSimulado();
    }
  } else {
    atualizarSensores();
  }

  if (ledApagarEm && millis() > ledApagarEm) {
    digitalWrite(PINO_LED, LOW);
    ledApagarEm = 0;
  }
}

